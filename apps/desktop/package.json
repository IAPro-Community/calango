{
  "name": "@calango/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:daemon": "go build -o ../../bin/calango ../../cmd/calango",
    "build:main": "tsc -p tsconfig.main.json",
    "test:main": "npm run build:main && node --test test/startup.test.cjs",
    "test:renderer": "vitest run",
    "build:renderer": "vite build",
    "build": "npm run build:daemon && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@calango/sdk-ts": "0.1.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "45.4.1",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.5",
    "vite": "7.2.2",
    "vitest": "5.1.0"
  }
}
