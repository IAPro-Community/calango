{
  "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
  "files": {
    "includes": [
      "apps/desktop/src/**",
      "apps/desktop/test/**",
      "apps/desktop/vite.config.ts",
      "apps/desktop/vitest.config.ts",
      "packages/sdk-ts/src/**",
      "scripts/*.mjs",
      "!packages/sdk-ts/src/schema.ts",
      "!apps/desktop/src/main/trayMessages.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
